<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Revit 2027 runs on .NET 10, and only on Windows. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Revit is a 64-bit program, so our dll must be 64-bit too. -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- Include WPF, Windows' library for building windows. -->
    <UseWPF>true</UseWPF>
    <!-- Two conveniences switched off, so nothing is added behind our backs. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
        <!-- Revit's files were built against newer copies of some Windows
         libraries than .NET 10 lists, and the build warns about the
         mismatch (MSB3277). It comes from Revit's files, not our code,
         and Revit uses its own copies, so show it as a quiet message. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <!-- The Revit API: the two files that let our code talk to Revit.
       Private=false means "don't copy them next to our dll";
       Revit already has them. -->
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <!-- Pack the button pictures inside the dll. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\*.png" />
  </ItemGroup>  
  <!-- After every build, copy the dll and the manifest to the folder
       where Revit 2027 looks for add-ins. Revit must be closed, because
       a running Revit keeps the dll locked.
       Building with -p:SkipRevitCopy=true only checks that the code
       compiles, which works while Revit is open. -->
  <Target Name="CopyToRevit" AfterTargets="Build" Condition="'$(SkipRevitCopy)' != 'true'">
    <PropertyGroup>
      <RevitAddinsFolder>$(AppData)\Autodesk\Revit\Addins\2027</RevitAddinsFolder>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(RevitAddinsFolder)\SGTools" />
    <Copy SourceFiles="SGTools.addin" DestinationFolder="$(RevitAddinsFolder)" />
  </Target>

</Project>