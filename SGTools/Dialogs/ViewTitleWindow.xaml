<Window x:Class="SGTools.Dialogs.ViewTitleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="View Number + Title"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        Loaded="WindowLoaded">

    <!-- Bring in the shared SG Tools colours and styles. Everything named
         SG.Something below comes from Styles/SGStyles.xaml. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SGTools;component/Styles/SGStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- The white card. The margin leaves room for its shadow. -->
    <Border Style="{StaticResource SG.WindowFrame}" Margin="24" Width="360"
            TextElement.FontFamily="{StaticResource SG.Font}"
            TextElement.FontSize="13"
            TextElement.Foreground="{StaticResource SG.Ink}">
        <DockPanel>

            <!-- Title bar: drag it to move the window -->
            <Border DockPanel.Dock="Top" Background="Transparent" Padding="14,8,8,8"
                    BorderBrush="{StaticResource SG.Line}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="DragWindow">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SG.CloseButton}"
                            Click="Cancel" ToolTip="Close"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" Margin="0,1,8,0" VerticalAlignment="Center"
                                 Fill="{StaticResource SG.Accent}"/>
                        <TextBlock Text="SG Tools 2.0" Margin="0,0,8,0"
                                   Foreground="{StaticResource SG.Muted}"/>
                        <TextBlock Text="View number + title" FontWeight="SemiBold"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Margin="16,14,16,18">

                <!-- Which view was picked -->
                <TextBlock Text="View" Style="{StaticResource SG.Label}" Margin="0"/>
                <TextBlock TextTrimming="CharacterEllipsis">
                    <Run x:Name="ViewNameRun" FontSize="15" FontWeight="SemiBold"/>
                    <Run x:Name="ViewTypeRun" Foreground="{StaticResource SG.Muted}"/>
                </TextBlock>

                <!-- Detail number -->
                <TextBlock Text="Detail number" Style="{StaticResource SG.Label}" Margin="0,16,0,4"/>
                <TextBox x:Name="NumberBox" Style="{StaticResource SG.TextBox}"
                         FontSize="15" FontWeight="SemiBold"
                         TextChanged="NumberChanged"/>

                <!-- Notice under the number: hidden until there is something to say -->
                <Border x:Name="Notice" CornerRadius="6" Padding="10,8" Margin="0,8,0,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="NoticeText" TextWrapping="Wrap"/>
                </Border>

                <!-- Title on sheet. The grey hint shows only while the field is empty. -->
                <TextBlock Text="Title on sheet" Style="{StaticResource SG.Label}" Margin="0,16,0,4"/>
                <Grid>
                    <TextBox x:Name="TitleBox" Style="{StaticResource SG.TextBox}"/>
                    <TextBlock x:Name="TitleHint" IsHitTestVisible="False"
                               Margin="11,0,11,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource SG.Muted}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TitleBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <TextBlock Text="Leave empty to show the view name." FontSize="12"
                           Margin="0,4,0,0" Foreground="{StaticResource SG.Muted}"/>

                <!-- Buttons: Enter presses Apply, Esc presses Cancel -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="Cancel" Style="{StaticResource SG.Button}" Margin="0,0,8,0"
                            IsCancel="True" Click="Cancel"/>
                    <Button Content="Apply" Style="{StaticResource SG.PrimaryButton}"
                            IsDefault="True" Click="Apply"/>
                </StackPanel>

            </StackPanel>
        </DockPanel>
    </Border>
</Window>
