<Window x:Class="SGTools.Dialogs.ViewTitleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="View Number + Title"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <StackPanel Margin="16" Width="300">

        <!-- Which view was clicked -->
        <TextBlock x:Name="ViewNameText" FontWeight="SemiBold"/>

        <!-- Detail number -->
        <TextBlock Text="Detail number" Margin="0,12,0,4"/>
        <TextBox x:Name="NumberBox"/>

        <!-- Title on sheet -->
        <TextBlock Text="Title on sheet (leave empty to show the view name)"
                   TextWrapping="Wrap" Margin="0,12,0,4"/>
        <TextBox x:Name="TitleBox"/>

        <!-- Buttons: Enter presses Apply, Esc presses Cancel -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Apply" Width="80" IsDefault="True" Click="ApplyClicked"/>
        </StackPanel>

    </StackPanel>
</Window>