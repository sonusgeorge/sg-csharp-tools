<Window x:Class="SGTools.Dialogs.PickBanner"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Focusable="False"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        Loaded="WindowLoaded">

    <!-- A small banner shown at the top of the drawing area while a tool
         waits for the user to click something. ShowActivated and
         Focusable are off so it never takes the keyboard away from Revit. -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SGTools;component/Styles/SGStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- The teal pill. The margin leaves room for its shadow. -->
    <Border Margin="16" CornerRadius="17" Padding="18,8"
            Background="{StaticResource SG.Accent}"
            TextElement.FontFamily="{StaticResource SG.Font}"
            TextElement.FontSize="13"
            TextElement.Foreground="{StaticResource SG.OnAccent}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270"
                              Color="#000000" Opacity="0.25"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="MessageText" FontWeight="SemiBold"/>
            <TextBlock Text="Esc to finish" Margin="14,0,0,0" Opacity="0.75"/>
        </StackPanel>
    </Border>
</Window>
