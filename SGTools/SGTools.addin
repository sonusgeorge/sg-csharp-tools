<?xml version="1.0" encoding="utf-8"?>
<!-- The manifest: Revit reads this file at startup to learn that the
     add-in exists, where its dll is, and which class to run. -->
<RevitAddIns>
  <!-- Type "Application" means: run this class when Revit starts.
       The class then builds the ribbon tab and its buttons. -->
  <AddIn Type="Application">
    <Name>SG Tools 2.0</Name>
    <!-- Where the dll is, relative to this file -->
    <Assembly>SGTools\SGTools.dll</Assembly>
    <!-- namespace.class of the application to run -->
    <FullClassName>SGTools.App</FullClassName>
    <!-- A unique ID, so Revit can tell this add-in from every other one -->
    <AddInId>71301770-0C83-499F-AD1F-990827F8F074</AddInId>
    <VendorId>SGTools</VendorId>
    <VendorDescription>Sonu George, https://github.com/sonusgeorge</VendorDescription>
  </AddIn>
</RevitAddIns>
